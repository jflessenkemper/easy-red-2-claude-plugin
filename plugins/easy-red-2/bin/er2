#!/usr/bin/env python3
"""Command-line front end for the easy-red-2 MCP tools.

Why this exists
---------------
The MCP tools are the right interface when Claude is driving. But plenty of real
work happens in a shell: a loop that records a clip after every reset, a script
that polls the log, a session where the MCP server is not connected yet because
the plugin was only just installed. That work was being done by a hand-written
shim in a scratchpad directory, which is unversioned, untested and drifts from
the server it is pretending to be.

This calls the SAME `t_*` functions the MCP tools call, so there is exactly one
implementation of "launch the game" and no second, subtly-wrong copy.

Usage
  er2 state
  er2 launch
  er2 screenshot --out /tmp/f.png
  er2 click '{"x": 813, "y": 887, "reliable": true}'
  er2 key '{"key": "space"}'
  er2 log '{"tag": "events", "lines": 40}'
  er2 --list
"""

import json
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "tools", "er2_mcp"))

try:
    import server
except ImportError as exc:                                   # pragma: no cover
    sys.exit("cannot import the MCP server module: %s" % exc)


def tool_names():
    return sorted(n[2:] for n in dir(server) if n.startswith("t_") and callable(getattr(server, n)))


def emit(blocks):
    """Print MCP content blocks as plain text.

    Image blocks are summarised rather than dumped: a base64 payload in a
    terminal is noise, and `--out` is the useful thing for a screenshot.
    """
    for blk in blocks or []:
        if not isinstance(blk, dict):
            print(blk)
            continue
        kind = blk.get("type")
        if kind == "text":
            print(blk.get("text", ""))
        elif kind == "image":
            data = blk.get("data") or ""
            print("<image %s, %d bytes base64>" % (blk.get("mimeType", "?"), len(data)))
        else:
            print(json.dumps(blk))


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        print("\navailable: " + ", ".join(tool_names()))
        return 0
    if argv[0] == "--list":
        for n in tool_names():
            print(n)
        return 0

    name = argv[0]
    fn = getattr(server, "t_" + name, None)
    if fn is None:
        print("unknown tool %r\navailable: %s" % (name, ", ".join(tool_names())), file=sys.stderr)
        return 2

    args = {}
    rest = argv[1:]
    # Accept either one JSON object, or --key value pairs, whichever is handier.
    if rest and rest[0].startswith("{"):
        try:
            args = json.loads(rest[0])
        except ValueError as exc:
            print("bad JSON argument: %s" % exc, file=sys.stderr)
            return 2
    else:
        i = 0
        while i < len(rest):
            tok = rest[i]
            if not tok.startswith("--"):
                print("expected --key value, got %r" % tok, file=sys.stderr)
                return 2
            key = tok[2:].replace("-", "_")
            if i + 1 < len(rest) and not rest[i + 1].startswith("--"):
                raw = rest[i + 1]
                i += 2
            else:
                raw = "true"
                i += 1
            # let JSON win where it can, so numbers and booleans arrive typed
            try:
                args[key] = json.loads(raw)
            except ValueError:
                args[key] = raw

    try:
        emit(fn(args))
    except Exception as exc:                                 # noqa: BLE001 - surface it plainly
        print("%s: %s" % (type(exc).__name__, exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
